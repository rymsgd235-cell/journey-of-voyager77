        "YAM", "YAP", "YES", "YET", "ZAP", "DAY", "DEN", "DIM",
        
        // 4-letter words
        "TENT", "MINT", "TEAM", "MEAT", "NAME", "TIME", "MAKE",
        "TAKE", "HAVE", "GAVE", "SAVE", "WAVE", "COME", "HOME",
        "BONE", "CONE", "DONE", "GONE", "ZONE", "TONE", "LONE",
